```python exec 
def get_zone_transects_time_bounded(zone_metrics, all_transects):
    """Helper function to extract transects for a specific time-bounded zone"""
    id_set = set(zone_metrics.transect_ids)
    results = []
    for tid, t in all_transects.items():
        if tid in id_set:
            t_copy = dict(t)
            t_copy["id"] = tid
            results.append(t_copy)
    return results

# Usage for time-bounded zone-specific map
zone_transects_tb = get_zone_transects_time_bounded(zone_metrics_tb, all_transects_time_bounded) 
