    temp_file_path = temp_file.name
    temp_file.close()
    
    # Save the time-bounded data to the temporary file
    # Use the cleaned-up data with renamed columns for consistency with zone definitions
    if 'site_primary_data_for_map' in locals() and time_bounded_analysis_available:
        # Use the properly renamed time-bounded data for narrative zoning
        site_primary_data_for_map.to_file(temp_file_path, driver='GeoJSON')
    else:
        # Fallback to original data if time-bounded analysis failed
        print(f"Fallback: Using original data with {len(site_primary_data_with_time_bounded)} transects for zone analysis")
        site_primary_data_with_time_bounded.to_file(temp_file_path, driver='GeoJSON')
    
    # Run narrative zoning on time-bounded data
    aois_time_bounded = run_narrative_zoning(
        site_id, 
        temp_file_path, 
        min_zone_length=min_zone_length_time_bounded, 
        zone_definitions=aoi_definitions, 
        sort_by_priority=True
    )
    aoi_zones_time_bounded = aois_time_bounded.get('zones', [])
    all_transects_time_bounded = aois_time_bounded.get('transects', [])
    
    # Clean up temporary file
    import os
    os.unlink(temp_file_path)
    
    time_bounded_zoning_available = len(aoi_zones_time_bounded) > 0
    
except Exception as e:
    print(f"Warning: Time-bounded narrative zoning failed for site {site_id}: {e}")
